# Copy this file to .env and fill in what you need.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (required)
# Default matches docker-compose's `db` service. If you're running Postgres
# yourself (e.g. via Supabase or Railway), replace this with your connection
# string. Must use the asyncpg driver prefix.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# ---------------------------------------------------------------------------
# Model routing (required)
# Which provider serves chat requests when the frontend doesn't specify one.
# Must be "ollama" for the mandatory local demo.
# ---------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama (required for the local demo)
# Run `ollama serve` locally, then `ollama pull llama3.2:3b` (or a larger
# model if your machine can handle it — see README for options).
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Anthropic (optional — only needed if you want to demo the cloud path)
# Leave blank to run local-only. Get a key at https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Embeddings (optional — sentence_transformers is the default and needs no
# key or network access at query time; switch to "ollama" to instead use
# Ollama's nomic-embed-text model)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Retrieval (optional — safe defaults)
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# ---------------------------------------------------------------------------
# Ingestion (optional)
# Leave TRANSCRIPT_SOURCE_URL unset to ingest the bundled sample transcripts
# (backend/data/sample_transcripts/) instead of a live corpus.
# ---------------------------------------------------------------------------
TRANSCRIPT_SOURCE_URL=
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_TOKENS=100

# ---------------------------------------------------------------------------
# CORS (optional — safe default for local dev)
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend-only (set in frontend/.env.local or via docker-compose)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
